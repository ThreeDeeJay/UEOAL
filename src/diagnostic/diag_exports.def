; UEOAL Diagnostic Passthrough - export definition
; Plain names, no aliasing needed (we define them directly, no xaudio2.h conflict)
LIBRARY "xaudio2_9redist"
EXPORTS
    XAudio2Create                @1
    XAudio2CreateWithVersionInfo @2
    CreateAudioVolumeMeter       @3
    CreateAudioReverb            @4
