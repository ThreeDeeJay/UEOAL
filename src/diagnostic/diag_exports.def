; UEOAL Diagnostic Passthrough - export definition
LIBRARY "xaudio2_9redist_diag"
EXPORTS
    XAudio2Create               = Diag_XAudio2Create               @1
    CreateAudioReverb            = Diag_CreateAudioReverb           @2
    CreateAudioVolumeMeter       = Diag_CreateAudioVolumeMeter      @3
    CreateFX                     = Diag_CreateFX                    @4
    X3DAudioCalculate            = Diag_X3DAudioCalculate           @5
    X3DAudioInitialize           = Diag_X3DAudioInitialize          @6
    XAudio2CreateWithVersionInfo = Diag_XAudio2CreateWithVersionInfo
